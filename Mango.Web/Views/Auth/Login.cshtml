@model LoginRequestDto

@{
    ViewData["Title"] = "Sign In";
}

<div class="d-flex align-items-center justify-content-center pb-5 pt-2">
    <div class="auth-card fade-in-up w-100" style="max-width:440px;">
        <div class="auth-card-header">
            <span class="auth-icon">&#129374;</span>
            <h2>Welcome Back</h2>
            <p>Sign in to your Mango account</p>
        </div>
        <div class="auth-card-body">
            <form method="post">
                <div class="mb-4">
                    <label asp-for="UserName" class="form-label">
                        <i class="bi bi-person me-1 text-gold"></i>Username
                    </label>
                    <input asp-for="UserName" class="form-control" placeholder="Enter your username" autofocus />
                    <span asp-validation-for="UserName" class="text-danger small"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="Password" class="form-label">
                        <i class="bi bi-lock me-1 text-gold"></i>Password
                    </label>
                    <div class="input-group">
                        <input asp-for="Password" type="password" class="form-control"
                               placeholder="Enter your password" id="passwordField" />
                        <button class="btn btn-outline-secondary" type="button" id="togglePassword"
                                style="border:2px solid var(--border-warm);">
                            <i class="bi bi-eye" id="toggleIcon"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="d-grid mb-4">
                    <button type="submit" class="btn btn-gold btn-lg">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
                    </button>
                </div>
                <div class="divider-ornament"><span>&#10022;</span></div>
                <div class="d-flex justify-content-center align-items-center gap-2 my-3">
                    <small class="text-muted">New to Mango?</small>
                    <a asp-controller="Auth" asp-action="Register"
                       style="color:var(--brand-primary);font-weight:700;text-decoration:none;">Create an account</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('togglePassword').addEventListener('click', function () {
            const f = document.getElementById('passwordField');
            const icon = document.getElementById('toggleIcon');
            f.type = f.type === 'password' ? 'text' : 'password';
            icon.classList.toggle('bi-eye');
            icon.classList.toggle('bi-eye-slash');
        });
    </script>
}
