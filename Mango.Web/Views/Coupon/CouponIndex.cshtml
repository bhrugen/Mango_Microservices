@model IEnumerable<CouponDto>

<div class="d-flex justify-content-between align-items-center mb-4 fade-in-up">
	<div>
		<div class="section-label"><span>Admin</span></div>
		<h2 class="section-title mb-0">Promo Codes</h2>
	</div>
	<a asp-action="CouponCreate" class="btn btn-gold">
		<i class="bi bi-plus-circle me-2"></i>Add Coupon
	</a>
</div>

<div class="card fade-in-up">
	<div class="card-body p-0">
		<table class="table" style="margin-bottom:0;">
			<thead>
				<tr>
					<th>Coupon Code</th>
					<th>Discount</th>
					<th>Min. Amount											</th>
											<th></th>
										</tr>
									</thead>
									<tbody>
										@foreach(var item in Model)
										{
											<tr>
												<td>
													<span class="badge badge-gold" style="font-size:.9rem;padding:.4rem .85rem;">
														<i class="bi bi-ticket-perforated me-1"></i>@item.CouponCode
													</span>
												</td>
												<td><span class="price-tag-sm" style="color:var(--restaurant-green);">@item.DiscountAmount.ToString("c")</span></td>
												<td><span class="text-muted">@item.MinAmount.ToString("c")</span></td>
												<td class="text-end">
													<a asp-action="CouponDelete" asp-route-couponId="@item.CouponId" class="btn btn-sm btn-danger">
														<i class="bi bi-trash"></i>
													</a>
												</td>
											</tr>
										}
									</tbody>
								</table>
							</div>
						</div>

</div>