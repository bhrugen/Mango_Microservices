@model ProductDto

@{
    ViewData["Title"] = Model.Name;
}

<div class="py-2">
    <form method="post">
        <input asp-for="ProductId" hidden />

        <div class="card fade-in-up"
            <div class="row g-0">

                <!-- ===== DISH IMAGE ===== -->
                <div class="col-lg-5">
                    <div class="position-relative h-100" style="min-height:320px;">
                        <img src="@Model.ImageUrl" alt="@Model.Name"
                             style="width:100%;height:100%;object-fit:cover;min-height:320px;" />

                        <!-- Overlay gradient -->
                        <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(28,28,28,0.6) 0%,transparent 50%);pointer-events:none;"></div>

                        <!-- Category chip -->
                        <div style="position:absolute;top:1rem;left:1rem;">
                            <span class="menu-card-badge">
                                <i class="bi bi-tag-fill me-1"></i>@Model.CategoryName
                            </span>
                        </div>

                        <!-- Price chip -->
                        <div style="position:absolute;bottom:1rem;left:1rem;">
                            <span style="font-family:Georgia,serif;font-size:1.75rem;font-weight:800;color:white;text-shadow:0 2px 8px rgba(0,0,0,.5);">
                                @string.Format("{0:c}", Model.Price)
                            </span>
                        </div>
                    </div>
                </div>

                <!-- ===== DISH INFO ===== -->
                <div class="col-lg-7">
                    <div class="card-body p-3 p-lg-4">

                        <div class="menu-card-category mb-1">@Model.CategoryName</div>

                        <h1 style="font-family:Georgia,serif;font-size:1.75rem;font-weight:700;color:var(--charcoal);line-height:1.2;margin-bottom:.75rem;">
                            @Model.Name
                        </h1>

                        <!-- Rating -->
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <div>
                                @for (int i = 0; i < 4; i++) {
                                    <i class="bi bi-star-fill" style="color:var(--brand-primary);font-size:.9rem;"></i>
                                }
                                <i class="bi bi-star-half" style="color:var(--brand-primary);font-size:.9rem;"></i>
                            </div>
                            <span class="small text-muted">4.5 &middot; 128 reviews</span>
                            <span class="badge bg-success ms-2">
                                <i class="bi bi-check-circle me-1"></i>Available
                            </span>
                        </div>

                        <div class="divider-ornament mb-3"><span>&#10022;</span></div>

                        <!-- Description -->
                        <div class="mb-3">
                            <p style="color:var(--text-muted);line-height:1.7;font-size:.9375rem;">
                                @Html.Raw(Model.Description)
                            </p>
                        </div>

                        <!-- Highlights -->
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <div class="trust-badge" style="padding:.5rem .75rem;">
                                    <i class="bi bi-fire" style="font-size:1rem;color:var(--brand-primary);"></i>
                                    <span class="small fw-semibold">Freshly Prepared</span>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="trust-badge" style="padding:.5rem .75rem;">
                                    <i class="bi bi-leaf" style="font-size:1rem;color:var(--restaurant-green);"></i>
                                    <span class="small fw-semibold">Fresh Ingredients</span>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="trust-badge" style="padding:.5rem .75rem;">
                                    <i class="bi bi-clock" style="font-size:1rem;color:var(--brand-primary);"></i>
                                    <span class="small fw-semibold">~20 Min Ready</span>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="trust-badge" style="padding:.5rem .75rem;">
                                    <i class="bi bi-shield-check" style="font-size:1rem;color:var(--restaurant-green);"></i>
                                    <span class="small fw-semibold">Hygiene Certified</span>
                                </div>
                            </div>
                        </div>

                        <!-- Quantity -->
                        <div class="mb-3">
                            <label class="form-label fw-bold" style="font-size:.85rem;text-transform:uppercase;letter-spacing:.5px;">
                                Quantity
                            </label>
                            <div class="d-flex align-items-center gap-3">
                                <div class="quantity-selector">
                                    <button type="button" id="decrementBtn">&#8722;</button>
                                    <input asp-for="Count" type="number" min="1" value="1" id="quantityInput" />
                                    <button type="button" id="incrementBtn">+</button>
                                </div>
                            </div>
                            <span asp-validation-for="Count" class="text-danger small"></span>
                        </div>

                        <!-- CTA Buttons -->
                        <div class="d-flex gap-3 flex-wrap">
                            <button type="submit" class="btn btn-gold px-4">
                                <i class="bi bi-bag-plus me-2"></i>Add to Order
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                                <i class="bi bi-arrow-left me-2"></i>Back to Menu
                            </a>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const input = document.getElementById('quantityInput');
        document.getElementById('incrementBtn').addEventListener('click', function () {
            input.value = parseInt(input.value) + 1;
        });
        document.getElementById('decrementBtn').addEventListener('click', function () {
            if (parseInt(input.value) > 1) input.value = parseInt(input.value) - 1;
        });
    </script>
}
