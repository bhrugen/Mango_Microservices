@model ProductDto

@{
    ViewData["Title"] = "Edit Dish";
}

<div class="container py-4">

    <!-- Page Header -->
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
        <div>
            <div class="section-label"><span>Admin</span></div>
            <h2 class="section-title mb-0">Edit Dish</h2>
        </div>
        <a asp-action="ProductIndex" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back
        </a>
    </div>

    <div class="row g-4 align-items-start">

        <!-- Form -->
        <div class="col-lg-7">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    <i class="bi bi-pencil-square me-2"></i>Dish Details
                </div>
                <div class="card-body p-4">
                    <form asp-action="ProductEdit" enctype="multipart/form-data">
                        <input type="hidden" asp-for="ProductId" />
                        <input type="hidden" asp-for="ImageLocalPath" />

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-semibold">Dish Name <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control" id="nameInput"
                                   placeholder="e.g. Mango Chicken Tikka" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="CategoryName" class="form-label fw-semibold">Category <span class="text-danger">*</span></label>
                                <input asp-for="CategoryName" class="form-control" id="categoryInput"
                                       placeholder="e.g. Main Course" />
                                <span asp-validation-for="CategoryName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Price" class="form-label fw-semibold">Price <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="Price" class="form-control" id="priceInput" placeholder="0.00" />
                                </div>
                                <span asp-validation-for="Price" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-semibold">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="4"
                                      placeholder="Describe the dish..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Image" class="form-label fw-semibold">
                                Replace Photo
                                <span class="text-muted fw-normal small">(leave empty to keep current)</span>
                            </label>
                            <input asp-for="Image" type="file" class="form-control" id="imageInput" accept="image/*" />
                            <input asp-for="ImageUrl" type="hidden" />
                            <span asp-validation-for="Image" class="text-danger small"></span>
                            <div class="form-text">Accepted: JPG, PNG, WEBP.</div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-warning fw-semibold px-4">
                                <i class="bi bi-check-circle me-1"></i>Save Changes
                            </button>
                            <a asp-action="ProductIndex" class="btn btn-outline-secondary px-4">Cancel</a>
                        </div>

                    </form>
                </div>
            </div>
        </div>

        <!-- Live Preview -->
        <div class="col-lg-5">
            <div class="card shadow-sm sticky-top" style="top:80px">
                <div class="card-header bg-secondary text-white">
                    <i class="bi bi-eye me-2"></i>Live Preview
                </div>
                <div id="previewImgWrap" style="height:200px; overflow:hidden;">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" class="w-100" style="height:200px;object-fit:cover;" alt="@Model.Name" />
                    }
                    else
                    {
                        <div class="h-100 bg-light d-flex align-items-center justify-content-center">
                            <i class="bi bi-camera text-secondary" style="font-size:3rem;"></i>
                        </div>
                    }
                </div>
                <div class="card-body">
                    <span class="badge bg-warning text-dark mb-2" id="previewCategory">@Model.CategoryName</span>
                    <h5 class="card-title fw-bold" id="previewName">@Model.Name</h5>
                    <p class="fs-5 fw-bold text-warning mb-0" id="previewPrice">@string.Format("{0:c}", Model.Price)</p>
                </div>
                <div class="card-footer text-muted small">
                    <i class="bi bi-info-circle me-1"></i>Updates as you type
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const nameInput     = document.getElementById('nameInput');
        const categoryInput = document.getElementById('categoryInput');
        const priceInput    = document.getElementById('priceInput');
        const imageInput    = document.getElementById('imageInput');

        nameInput?.addEventListener('input', () =>
            document.getElementById('previewName').textContent = nameInput.value || 'Dish Name');

        categoryInput?.addEventListener('input', () =>
            document.getElementById('previewCategory').textContent = categoryInput.value || 'Category');

        priceInput?.addEventListener('input', () =>
            document.getElementById('previewPrice').textContent =
                priceInput.value ? `$${parseFloat(priceInput.value).toFixed(2)}` : '$0.00');

        imageInput?.addEventListener('change', function () {
            const file = this.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = e => {
                document.getElementById('previewImgWrap').innerHTML =
                    `<img src="${e.target.result}" class="w-100" style="height:200px;object-fit:cover;" alt="preview">`;
            };
            reader.readAsDataURL(file);
        });
    </script>
}

